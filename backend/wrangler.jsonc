{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "queen-of-spades",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://4c4ab488.queen-of-spades.pages.dev",
    "ALLOWED_ORIGIN_SUFFIX": "queen-of-spades.pages.dev"
  }
}
